# ═══════════════════════════════════════════════════════════════════════════
# SamarthX Superset - Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# 
# IMPORTANT: 
# 1. Copy this file to .env
# 2. Generate strong secrets using: python -c "import secrets; print(secrets.token_urlsafe(42))"
# 3. Never commit .env to version control
# 4. Set these as system environment variables on Windows
#
# ═══════════════════════════════════════════════════════════════════════════

# Environment mode (production/development)
SUPERSET_ENV=production

# Flask secret key - REQUIRED (generate a strong random key)
SUPERSET_SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET

# Guest token JWT secret - REQUIRED (generate a strong random key)
GUEST_TOKEN_JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# Database connection string
DATABASE_URI=postgresql+psycopg2://superset_user:YOUR_STRONG_PASSWORD@localhost:5432/superset

# Embedded portal origin (the domain that will embed your dashboards)
EMBEDDED_PORTAL_ORIGIN=https://ga.samarthx.du.ac.in

# Mapbox API key (optional, for map visualizations)
MAPBOX_API_KEY=

# Superset configuration file path
SUPERSET_CONFIG_PATH=C:\Users\Admin\Downloads\superset 2\superset 2\superset\superset_config.py
