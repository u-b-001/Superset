    "table_schema": "public",
    "has_custom_sql": true,
    "custom_sql": "SELECT\n  e.employee_user_id,\n  ts.employee_designation\nFROM\n  teaching_staff as ts \nJOIN\n  employees as e\nON e.employee_user_id = ts.employee_user_id\nWHERE \n  UPPER(e.associated_school) NOT LIKE '%TEST%'",
